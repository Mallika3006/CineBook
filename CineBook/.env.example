# ============================================================================
# CineBook Environment Configuration Example
# Copy this file to .env (or configure in IntelliJ IDEA Run Configuration)
# Never commit real credentials or production secrets to source control!
# ============================================================================

# Server Configuration
SERVER_PORT=8080
APP_TIMEZONE=Asia/Kolkata
APP_DEFAULT_CITY=Bengaluru

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinebook
DB_USERNAME=cinebook_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# JWT Authentication Configuration (Must be at least 32 characters / 256 bits)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_256_BIT_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_NAME=cinebook_auth_token
JWT_COOKIE_SECURE=false

# Booking & Showtime Business Rules
BOOKING_MAX_SEATS_PER_ORDER=10
BOOKING_CONVENIENCE_FEE_PERCENT=8.50
BOOKING_GST_ON_FEE_PERCENT=18.00
BOOKING_HOLD_DURATION_SECONDS=300
BOOKING_CANCELLATION_CUTOFF_MINUTES=60
SHOWTIME_TURNAROUND_BUFFER_MINUTES=25

# Initial Admin Bootstrap (Set CINEBOOK_ADMIN_BOOTSTRAP_ENABLED=true on first startup)
CINEBOOK_ADMIN_BOOTSTRAP_ENABLED=true
CINEBOOK_ADMIN_NAME=CineBook System Admin
CINEBOOK_ADMIN_EMAIL=admin@cinebook.local
CINEBOOK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_123!

# Optional Seed Demo Customer (Set CINEBOOK_DEMO_CUSTOMER_ENABLED=true for local demo)
CINEBOOK_DEMO_CUSTOMER_ENABLED=true
CINEBOOK_DEMO_CUSTOMER_NAME=Aarav Sharma
CINEBOOK_DEMO_CUSTOMER_EMAIL=customer@cinebook.local
CINEBOOK_DEMO_CUSTOMER_PASSWORD=CHANGE_ME_CUSTOMER_PASSWORD_123!

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
